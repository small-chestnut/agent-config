{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "permissions": {
    "deny": [
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm --recursive*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(rm * -fr*)",
      "Bash(rm * -fR*)",
      "Bash(rm * --recursive*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(terraform destroy*)",
      "Bash(trash-empty*)",
      "Bash(trash-rm*)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "PowerShell(Remove-Item -Recurse*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(rm -Recurse*)",
      "PowerShell(rd -Recurse*)",
      "PowerShell(Format-Volume*)",
      "PowerShell(git push --force)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)"
    ],
    "ask": [
      "Bash(git push --force-with-lease*)",
      "Bash(git push*)",
      "Bash(git restore *)",
      "PowerShell(git push --force-with-lease*)",
      "PowerShell(git push*)",
      "PowerShell(git restore *)"
    ],
    "allow": [
      "Bash(trash *)",
      "Bash(trash-put *)",
      "Bash(trash-list*)",
      "Bash(trash-restore*)",
      "mcp__tts__voicevox_speak",
      "mcp__tts__voicevox_ping",
      "mcp__tts__voicevox_get_speakers",
      "mcp__tts__voicevox_stop_speaker",
      "mcp__comfyui__download_model",
      "mcp__comfyui__generate_image",
      "mcp__comfyui__enqueue_workflow",
      "mcp__comfyui__create_workflow",
      "mcp__comfyui__save_workflow",
      "mcp__comfyui__get_workflow",
      "mcp__comfyui__visualize_workflow",
      "mcp__comfyui__get_history",
      "mcp__comfyui__get_image",
      "mcp__comfyui__upload_image",
      "mcp__comfyui__queue",
      "mcp__comfyui__get_system_stats",
      "mcp__comfyui__get_defaults",
      "mcp__comfyui__model_metadata",
      "mcp__comfyui__clear_vram",
      "mcp__comfyui__list_tools",
      "mcp__comfyui__describe_tool",
      "mcp__comfyui__list_api_nodes",
      "mcp__comfyui__list_packs",
      "mcp__comfyui__search_custom_nodes",
      "mcp__comfyui__calculate"
    ]
  }
}
